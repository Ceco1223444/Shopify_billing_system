# Local Supabase: run `pnpm env:local`, which writes apps/web/.env.local for you.
# Hosted project: copy this file to apps/web/.env.hosted.local, fill it in from
# Project Settings -> API Keys (the URL and the *publishable* key), then run `pnpm dev:hosted`.
# Never put the secret / service_role key here: everything in this file reaches the browser.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Shows the /dev/sync connection-check page in a production build (always on in dev mode).
VITE_ENABLE_DEV_PAGES=false
