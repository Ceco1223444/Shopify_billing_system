{
  "name": "@happyhome/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript domain logic for HappyHome Shipping Hub. No I/O.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./import": "./src/import/index.ts",
    "./couriers": "./src/couriers/index.ts",
    "./geo": "./src/geo/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
